{
  "calls": [
    {
      "name": "model_switch",
      "tool": "traecn_switch_model",
      "arguments": {
        "name": "GLM-5.2",
        "waitForQueue": false
      }
    },
    {
      "name": "security_review",
      "tool": "traecn_review_code",
      "arguments": {
        "instruction": "Findings first: review this file for security defects.",
        "files": ["src/shared/mcp-auth.js"],
        "focus": ["authentication", "authorization", "tests"]
      }
    },
    {
      "name": "human_reviewed_workflow",
      "tool": "traecn_run_unattended_workflow",
      "arguments": {
        "task": "修复登录页样式",
        "steps": ["补充快照测试", "更新 CHANGELOG"],
        "reviewRequired": true,
        "autoContinue": false
      }
    },
    {
      "name": "wait_for_checkpoint",
      "tool": "traecn_wait_task",
      "arguments": {
        "taskId": "TASK_ID",
        "pollMs": 5000,
        "timeoutMs": 600000
      }
    },
    {
      "name": "approve_gateway_checkpoint",
      "tool": "traecn_resolve_task_review",
      "arguments": {
        "taskId": "TASK_ID",
        "decision": "approve",
        "notes": "Reviewed generated changes"
      }
    },
    {
      "name": "keep_trae_internal_changes",
      "tool": "traecn_resolve_review_gate",
      "arguments": {
        "action": "keep_all"
      }
    },
    {
      "name": "long_queue_proof_dry_run",
      "tool": "traecn_start_long_queue_proof",
      "arguments": {
        "execute": false,
        "allowQuotaSpend": false
      }
    }
  ]
}
