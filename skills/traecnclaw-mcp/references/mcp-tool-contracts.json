{
  "source": "mcp-server.js",
  "profiles": {
    "default": {
      "default": true,
      "count": 6,
      "description": "Single compact Agent surface. Gateway-owned mechanics are intentionally not exposed as tools.",
      "tools": [
        "traecn_submit",
        "traecn_get_task",
        "traecn_cancel_task",
        "traecn_list_conversations",
        "traecn_manage_conversation",
        "traecn_resolve_interaction"
      ]
    }
  },
  "tools": [
    {
      "name": "traecn_submit",
      "description": "Submit work to TraeCN. The gateway prepares the workspace, model, mode and conversation, then owns queueing, recovery and completion delivery.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "The exact message to send to TraeCN."
          },
          "model": {
            "type": "string",
            "description": "Optional preferred model."
          },
          "mode": {
            "type": "string",
            "enum": [
              "solo",
              "ide"
            ],
            "description": "Optional preferred TraeCN mode."
          },
          "workspace": {
            "type": "string",
            "description": "Optional local folder to open before submission. It is never added to the message."
          },
          "conversationId": {
            "type": "string",
            "description": "Optional conversation returned by traecn_list_conversations."
          },
          "newConversation": {
            "type": "boolean",
            "description": "Create a conversation before sending."
          },
          "steps": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "completionChecks": {
                      "type": "object"
                    }
                  }
                }
              ]
            },
            "description": "Optional follow-up work automatically continued by the gateway."
          },
          "completionChecks": {
            "type": "object"
          }
        },
        "required": [
          "message"
        ]
      },
      "metadata": {
        "layer": "task",
        "risk": "delegate"
      }
    },
    {
      "name": "traecn_get_task",
      "description": "Read one task only when an explicit progress or final-result check is needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          }
        },
        "required": [
          "taskId"
        ]
      },
      "metadata": {
        "layer": "task",
        "risk": "read"
      }
    },
    {
      "name": "traecn_cancel_task",
      "description": "Cancel a task. The gateway removes queued work or stops the active TraeCN generation as appropriate.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          }
        },
        "required": [
          "taskId"
        ]
      },
      "metadata": {
        "layer": "task",
        "risk": "delegate",
        "destructive": true
      }
    },
    {
      "name": "traecn_list_conversations",
      "description": "List TraeCN conversations in the current mode with stable gateway conversation identifiers.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "metadata": {
        "layer": "conversation",
        "risk": "read"
      }
    },
    {
      "name": "traecn_manage_conversation",
      "description": "Create, select or delete a TraeCN conversation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "select",
              "delete"
            ]
          },
          "conversationId": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      },
      "metadata": {
        "layer": "conversation",
        "risk": "write",
        "destructive": true
      }
    },
    {
      "name": "traecn_resolve_interaction",
      "description": "Resolve only an exceptional TraeCN question or unsafe approval that the gateway cannot safely handle automatically.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "deny",
              "answer",
              "dismiss"
            ]
          },
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      },
      "metadata": {
        "layer": "interaction",
        "risk": "delegate",
        "destructive": true
      }
    }
  ]
}
