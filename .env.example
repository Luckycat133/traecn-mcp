# TraeCN application startup
TRAECN_BIN=
TRAECN_ARGS=
TRAECN_PROJECT_PATH=
TRAECN_QUICKSTART_USE_ISOLATED_PROFILE=1
TRAECN_QUICKSTART_REMOTE_DEBUGGING_PORT=9333

# CDP target discovery
TRAECN_CDP_HOST=127.0.0.1
TRAECN_REMOTE_DEBUGGING_PORT=9222
TRAECN_CDP_TARGET_TITLE_CONTAINS=Trae
TRAECN_CDP_TARGET_URL_CONTAINS=

# DOM selectors. Leave blank to use built-in fallback selectors.
TRAECN_COMPOSER_SELECTORS=
TRAECN_SEND_BUTTON_SELECTORS=
TRAECN_RESPONSE_SELECTORS=
TRAECN_ACTIVITY_SELECTORS=
TRAECN_NEW_CHAT_SELECTORS=
TRAECN_MODE_TAB_SELECTORS=
TRAECN_SEND_TRIGGER=button

# Dual UI mode (SOLO / IDE) selectors
TRAECN_IDE_TASK_PANEL_SELECTORS=
TRAECN_IDE_RESPONSE_SELECTORS=
TRAECN_IDE_NEW_CHAT_SELECTORS=
TRAECN_IDE_INDICATOR_SELECTORS=
TRAECN_SOLO_INDICATOR_SELECTORS=

# Mode switching defaults
TRAECN_DEFAULT_MODE=solo
TRAECN_MODE_SWITCH_WAIT_MS=2000

# Response collection and queue handling
TRAECN_RESPONSE_POLL_INTERVAL_MS=350
TRAECN_RESPONSE_IDLE_MS=1200
TRAECN_RESPONSE_TIMEOUT_MS=30000
TRAECN_POST_ACTION_DELAY_MS=350
TRAECN_SESSION_PREPARE_TIMEOUT_MS=5000

# Queue handling (Trae CN free models often queue)
TRAECN_QUEUE_POLL_INTERVAL_MS=15000     # How often background poller checks if queue cleared
TRAECN_QUEUE_WAIT_TIMEOUT_MS=600000     # Total queue wait timeout (default 10 min)
TRAECN_QUEUE_PER_TASK_TIMEOUT_MS=600000 # Per-task max queue wait (default 10 min)
TRAECN_QUEUE_STATUS_POLL_INTERVAL_MS=5000 # How often checkQueueStatus() polls UI for position updates

# HTTP gateway
HOST=127.0.0.1
PORT=8788
TRAECN_GATEWAY_TOKEN=
TRAECN_AUTH_HEADER=Authorization
TRAECN_ALLOWED_ORIGINS=
TRAECN_RATE_LIMIT_WINDOW_MS=60000
TRAECN_RATE_LIMIT_MAX_REQUESTS=60
TRAECN_ENABLE_DEBUG_ENDPOINTS=0
TRAECN_ENABLE_MOCK_BRIDGE=0
