# TraeCN 启动配置
TRAECN_BIN=/Applications/Trae CN.app
TRAECN_ARGS=
TRAECN_REMOTE_DEBUGGING_PORT=9222
TRAECN_PROJECT_PATH=
TRAECN_QUICKSTART_USE_ISOLATED_PROFILE=1
TRAECN_QUICKSTART_REMOTE_DEBUGGING_PORT=9222

# CDP 目标选择
TRAECN_CDP_HOST=127.0.0.1
# 留空则自动匹配 Trae CN 的任何页面
TRAECN_CDP_TARGET_TITLE_CONTAINS=
TRAECN_CDP_TARGET_URL_CONTAINS=

# DOM 选择器（已通过 inspect-traecn.js 探测）
TRAECN_COMPOSER_SELECTORS=.chat-input-v2-input-box-editable,textarea,[contenteditable='true']
TRAECN_SEND_BUTTON_SELECTORS=button.chat-input-v2-send-button,button[data-testid*='send'],button[type='submit']
TRAECN_RESPONSE_SELECTORS=.assistant-chat-turn-content,.agent-plan-items.assistant-chat-turn-element,.icd-open-folder-card-desc,[data-role='assistant'],.assistant
TRAECN_ACTIVITY_SELECTORS=.chat-content-container,.chat-list-wrapper,[class*="activity"]
TRAECN_NEW_CHAT_SELECTORS=a.codicon-icube-NewChat,[class*="NewChat"],[class*="new-task"]
TRAECN_MODE_TAB_SELECTORS=.icube-mode-tab-item,[class*='icube-mode-tab-item'],[class*="mode-tab"]
TRAECN_SEND_TRIGGER=button

# 响应采集
TRAECN_RESPONSE_POLL_INTERVAL_MS=350
TRAECN_RESPONSE_IDLE_MS=1200
TRAECN_RESPONSE_TIMEOUT_MS=120000
TRAECN_POST_ACTION_DELAY_MS=350
TRAECN_SESSION_PREPARE_TIMEOUT_MS=5000

# 排队等待（队列自动消化）
TRAECN_QUEUE_WAIT_TIMEOUT_MS=600000       # 总排队超时（默认10分钟）
TRAECN_QUEUE_POLL_INTERVAL_MS=15000       # 后台轮询间隔
TRAECN_QUEUE_PER_TASK_TIMEOUT_MS=600000   # 每个任务的排队超时（默认10分钟）
TRAECN_QUEUE_STATUS_POLL_INTERVAL_MS=5000 # checkQueueStatus UI轮询间隔

# HTTP 网关
HOST=127.0.0.1
PORT=8788
TRAECN_GATEWAY_TOKEN=
TRAECN_ALLOWED_ORIGINS=
TRAECN_RATE_LIMIT_WINDOW_MS=60000
TRAECN_RATE_LIMIT_MAX_REQUESTS=60
TRAECN_ENABLE_DEBUG_ENDPOINTS=0
TRAECN_ENABLE_MOCK_BRIDGE=1
